# Copy this file to ".env" (same folder) and fill in real values. ".env" is git-ignored.

# --- Database ---
DB_URL=jdbc:mysql://localhost:3306/examforge?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=change-me

# --- JWT --- (generate: openssl rand -base64 48)
JWT_SECRET=replace-with-at-least-32-random-bytes-base64

# --- First admin (created once on startup if no admin exists) ---
ADMIN_EMAIL=admin@example.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-Strong1

# --- Google Sign-In (https://console.cloud.google.com/apis/credentials) ---
GOOGLE_WEB_CLIENT_ID=
# Android / iOS client ids for the mobile app, comma-separated
GOOGLE_EXTRA_CLIENT_IDS=

# --- Mail ---
# MAIL_ENABLED=false prints verification/reset links in the backend log instead of sending.
# Gmail: turn on 2-Step Verification, create an App Password (https://myaccount.google.com/apppasswords)
# and use it below — NOT your normal Gmail password.
MAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your.address@gmail.com
MAIL_PASSWORD=your-16-char-app-password
# Gmail requires the From address to be your Gmail address
MAIL_FROM=ExamForge <your.address@gmail.com>

# --- Web ---
APP_FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# true in production (HTTPS)
COOKIE_SECURE=false
REQUIRE_VERIFIED_EMAIL=false

# --- Development: add sample questions + 3 sample exams when the question bank is empty ---
SEED_DEMO_DATA=false
