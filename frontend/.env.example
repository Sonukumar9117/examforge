# Copy to ".env". Leave VITE_API_BASE_URL empty in development (Vite proxies /api to localhost:8080).
# In production set it to the API origin, e.g. https://api.examforge.example
VITE_API_BASE_URL=
# The Google client id is read from the backend (/api/v1/auth/config), so it is configured only once
# in backend/.env as GOOGLE_WEB_CLIENT_ID.
